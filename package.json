{
  "name": "corral",
  "version": "0.1.0",
  "private": true,
  "description": "Files, source control, pull requests, ports and agent usage for the Herdr app.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "types": "node scripts/sync-types.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "check": "node scripts/check.mjs",
    "link": "node scripts/link.mjs",
    "unlink": "node scripts/link.mjs --remove",
    "verify": "npm run build && npm test && npm run types && npm run typecheck && npm run check"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
